{
  "manifest_version": 3,
  "name": "VoiceFiller",
  "version": "1.7",
  "description": "Autofill web forms using your voice with AI and wake word detection.",
  "permissions": ["activeTab", "scripting", "downloads"],
  "host_permissions": ["<all_urls>", "http://localhost/*", "https://localhost/*"],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon.png",
      "48": "icons/icon.png",
      "128": "icons/icon.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>", "http://localhost/*", "https://localhost/*"],
      "js": ["content.js"],
      "type": "module"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["utils/*.js", "utils/libs/*.js"],
      "matches": ["<all_urls>"]
    }
  ],
  "icons": {
    "16": "icons/icon.png",
    "48": "icons/icon.png",
    "128": "icons/icon.png"
  }
}